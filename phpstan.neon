includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src/
        - config/
        - database/
    excludePaths:
        analyse:
            # Extends spatie/laravel-responsecache's profile, an optional
            # package (composer suggest): only loaded when it is installed.
            - src/Cache/FullPageCacheProfile.php
    ignoreErrors:
        - identifier: larastan.noEnvCallsOutsideOfConfig
          path: config/sunrice.php
        - message: '#Class App\\Models\\User not found#'
          path: config/sunrice.php
