{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "esModuleInterop": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": { "@/*": ["./resources/js/*"] },
        "types": ["vite/client"]
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx"]
}
